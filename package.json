{
  "name": "joypad-air",
  "version": "2.0.0",
  "description": "Turn your iPhone into a gamepad for Ryujinx, Dolphin & Cemu on macOS \u2014 DSU (cemuhook) motion + low-latency buttons over Wi-Fi. A.K.A. \"El Control Super Pro Max\"",
  "license": "MIT",
  "type": "module",
  "bin": {
    "joypad-air": "server/cli.js"
  },
  "files": [
    "server/",
    "public/",
    "tools/",
    "install.sh",
    "README.md",
    "README.es.md",
    "LICENSE",
    "RELEASING.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:dance": "node tools/start-dance.mjs",
    "start:paired": "node tools/start-pairing.mjs",
    "play": "node tools/start-pairing.mjs --launch",
    "dev": "node --watch server/index.js",
    "test": "node tools/smoke-test.mjs",
    "ryujinx:setup": "node tools/ryujinx-setup.mjs",
    "ryujinx:pro": "node tools/ryujinx-setup.mjs",
    "ryujinx:sideways": "node tools/ryujinx-setup.mjs --sideways",
    "ryujinx:dance": "node tools/ryujinx-setup.mjs --just-dance --patched",
    "ryujinx:build": "bash tools/ryujinx-build/build-local.sh",
    "ryujinx:prepare": "node tools/ryujinx-build/prepare-local.mjs",
    "ryujinx:launch": "bash tools/ryujinx-build/launch-local.sh",
    "test:motion": "node --test tools/motion-test.mjs",
    "test:pairing": "node --test tools/pairing-test.mjs",
    "test:launcher": "node --test tools/launcher-test.mjs",
    "ryujinx:check": "node tools/ryujinx-setup.mjs --check",
    "test:i18n": "node --test tools/i18n-test.mjs",
    "test:ryujinx": "node --test tools/ryujinx-test.mjs"
  },
  "keywords": [
    "gamepad",
    "virtual-controller",
    "phone-as-gamepad",
    "dsu",
    "cemuhook",
    "ryujinx",
    "dolphin-emu",
    "cemu",
    "macos",
    "ios",
    "pwa",
    "motion-controls"
  ],
  "dependencies": {
    "@nut-tree-fork/nut-js": "4.2.6",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  }
}
